struct CharItem {
    text: string,
    trial: bool,
    correct: bool,
    misplaced: bool,
}

component CharBlock inherits Rectangle {
    in property <string> show_char;
    in property <bool> trial;
    in property <bool> correct;
    in property <bool> misplaced;

    width: 60px;
    height: 60px;
    border-radius: 6px;
    background: trial
        ? #FFFFFF
        : (correct ? #6AAA64 : (misplaced ? #C9B458 : #787C7E));
    border-width: trial ? 2px : 0px;
    border-color: show_char == "" ? #D3D6DA : #878A8C;

    animate background { duration: 180ms; easing: ease-out; }
    animate border-color { duration: 140ms; easing: ease-out; }

    Text {
        text: show_char;
        font-size: 30px;
        font-weight: 700;
        color: trial ? #1A1A1B : #FFFFFF;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component PillButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <color> base-color;
    in property <color> hover-color;
    in property <color> pressed-color;
    callback clicked;

    width: 128px;
    height: 36px;
    border-radius: 18px;
    background: !root.enabled
        ? #D3D6DA
        : (touch.pressed
            ? root.pressed-color
            : (touch.has-hover ? root.hover-color : root.base-color));

    animate background { duration: 120ms; easing: ease-out; }

    Text {
        text: root.label;
        font-size: 12px;
        font-weight: 700;
        color: #FFFFFF;
        letter-spacing: 2px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    width: 400px;
    height: 600px;
    background: #FFFFFF;
    title: "Rordle";
    // Give the keyboard handler focus at startup; otherwise key presses are
    // dropped until the user clicks inside the window.
    forward-focus: key_handler;

    in property <int> level;
    in property <int> index;
    in property <bool> invalid: false;
    in property <bool> success: false;
    in property <bool> failed: false;
    in property <bool> hint_pending: false;
    in property <string> answer_text;
    in property <[CharItem]> char_items: [];

    callback handle_keyboard(string);
    callback reset();
    callback hint();

    key_handler := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            root.handle_keyboard(event.text);
            accept
        }

        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 22px;
            padding-bottom: 22px;
            spacing: 14px;

            // Header
            Text {
                text: "RORDLE";
                font-size: 34px;
                font-weight: 700;
                color: #1A1A1B;
                letter-spacing: 4px;
                horizontal-alignment: center;
            }

            Rectangle {
                height: 1px;
                background: #D3D6DA;
            }

            // Board
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 320px;
                    height: 385px;
                    for tile[i] in char_items: CharBlock {
                        x: mod(i, 5) * 65px;
                        y: floor(i / 5) * 65px;
                        show_char: tile.text;
                        trial: tile.trial;
                        correct: tile.correct;
                        misplaced: tile.misplaced;
                    }
                }
            }

            // Status
            Text {
                height: 22px;
                text: root.success
                    ? "You got it!"
                    : (root.failed
                        ? "Answer: " + root.answer_text
                        : (root.invalid
                            ? "Not in word list"
                            : (root.hint_pending ? "Finding a hint..." : "")));
                font-size: 15px;
                font-weight: 600;
                color: root.success
                    ? #6AAA64
                    : (root.failed
                        ? #1A1A1B
                        : (root.invalid ? #B85450 : #787C7E));
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Footer
            HorizontalLayout {
                alignment: center;
                spacing: 12px;
                PillButton {
                    label: "HINT";
                    enabled: !root.success && !root.failed && !root.hint_pending;
                    base-color: #C9B458;
                    hover-color: #B8A44D;
                    pressed-color: #A69343;
                    clicked => { root.hint(); }
                }
                PillButton {
                    label: "NEW GAME";
                    base-color: #6AAA64;
                    hover-color: #5E9959;
                    pressed-color: #4F8850;
                    clicked => { root.reset(); }
                }
            }
        }
    }
}
